# =============================================================================
# Abdi Online Shop - Environment Configuration Template
# =============================================================================
# Copy this file to `backend/.env` and update the values for your environment.
# NEVER commit the actual `.env` file containing secrets to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Example: postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/abdi_shop?sslmode=require

# Authentication & JWT
# Minimum 32-character high-entropy secret for production
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# CORS & Frontend Origins
# Comma-separated list of allowed origins (e.g., http://localhost:3000,https://shop.example.com)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Initial Seed Admin Account
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@abdi.com
ADMIN_PASSWORD=change_this_admin_password_in_production

# Customer Maintenance Mode (default: false, set to true to enable)
MAINTENANCE_MODE=false

